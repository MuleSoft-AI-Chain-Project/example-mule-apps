	<flow name="A2AClientHTTPListener" doc:id="34566267-6d4b-4722-a881-299a137e8c71" >
		<http:listener doc:name="Listener" doc:id="f244fde1-fa14-487c-a684-53de72cbdb9a" config-ref="A2A_Client_HTTP_Listener_config" path="/a2a-client"/>
		<ee:transform doc:name="Transform Message" doc:id="d2ea61d3-b090-4248-9b70-332b1e07f186">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"id": uuid(),
	"sessionId": uuid(),
	"message": {
		"kind": "message",
		"messageId": uuid(),
		"role": "user",
		"parts": [
			{
				"kind": "text",
				"text": payload.prompt as String
			}
		]
	}
}
]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<a2a:send-message doc:name="Send message" doc:id="4d163f43-78b7-489b-91f8-848d3e6f2d59" config-ref="A2A_Client">
			<a2a:message ><![CDATA[#[payload]]]></a2a:message>
		</a2a:send-message>
	</flow>
	<flow name="A2AAgentFlow" doc:id="b05c760b-c679-4b7e-8b4c-5efddb4f24f9" >
		<a2a:task-listener doc:name="Task Listener" doc:id="f4bf38a5-47f0-43cc-b9ca-bb970747c47a" config-ref="A2A_Server"/>
		<logger level="INFO" doc:name="Logger" doc:id="e51caaa0-4a70-4fa9-8818-dca7cfdcc0f6" message="#[payload]"/>
		<flow-ref doc:name="Setting defaults" doc:id="966a72ba-fe01-48a1-843f-b76a4da03d9a" name="set-and-initialise-vars-a2a-agent" />
		<flow-ref doc:name="Create a plan" doc:id="3b9a1b45-2b3b-403e-92b5-145a52917e19" name="create-plan" />
		<ee:transform doc:name="Prepare A2A Server Response" doc:id="0b9b44b4-ae5a-457b-884f-bab9dd714cd6" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  id: vars.taskId,                 // REQUIRED Task.id (must not be null)
  kind: "task",
  contextId: vars.contextId,       // use the passed-in context, not a new uuid
  status: {
    state: "completed"
  },
  metadata: {},
  artifacts: [
    {
      artifactId: uuid(),
      name: "task",
      parts: [
        {
          kind: "text",
          text: (payload.response default "") as String
        },
        {
          kind: "data",
          data: {
            toolResults: vars.toolResults default []
          }
        }
      ]
    }
  ],
  history: [
    {
      role: "user",
      kind: "message",
      parts: [
        {
          kind: "text",
          text: (vars.userPrompt default "") as String
        }
      ],
      messageId: vars.messageId,
      taskId: vars.taskId,
      contextId: vars.contextId
    }
