---
vars.planningPayload.tools[(vars.counter default 1) as Number - 1].function.name default null]" doc:name="Call tool" doc:id="5f516dbe-c1f7-446c-a8e2-4fde6e83da16" config-ref="MCP_Client">
			<mcp:arguments><![CDATA[#[%dw 2.0
output application/json
var arg = vars.planningPayload.tools[(vars.counter default 1) as Number - 1].function.arguments default {}
---
if (arg is String) read(arg, "application/json") else arg]]]></mcp:arguments>
		</mcp:call-tool>
		<ee:transform doc:name="ToolResponse" doc:id="4372063b-e450-4afa-8b98-073118d14bd7">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
