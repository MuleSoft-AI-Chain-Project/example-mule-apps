	<sub-flow name="set-and-initialise-vars-a2a-agent" doc:id="a43ce58c-e841-440e-9fcf-f534601d9c6f">
		<set-variable value='#[payload.message.parts[0].text default ""]' doc:name="Prompt" doc:id="efe3f6e3-a8ea-4ea8-ae95-edfb5d7ba4b2" variableName="userPrompt" />
		<set-variable value="#[attributes.taskId default uuid()]" doc:name="Set Task Id" doc:id="4d3a116c-c8cc-4208-accf-32a8ba33f904" variableName="taskId" />
		<set-variable value='#[(attributes.contextId) default ""]' doc:name="Set context Id" doc:id="ce3ac3ad-6298-401d-b7ff-ce641c10a151" variableName="contextId" />
		<set-variable value="#[payload.message.messageId]" doc:name="Set Message Id" doc:id="0c8b59e6-78e5-49df-a13a-a58ac8772a0f" variableName="messageId" />
		<set-variable value='#["Tool results: "]' doc:name="set multiTools results" doc:id="9f51a056-50c0-4946-929a-4d06efbe899b" variableName="multiToolsResult" />
		<set-variable value="#[[]]" doc:name="set toolsUsed" doc:id="448cf75b-e4ac-4d8c-9a71-7ef98f6296b8" variableName="toolsUsed" />
		<set-variable value="#[[]]" doc:name="set toolResults" doc:id="d5e7a811-1b3c-4a2d-ae90-1b3e8b9e0001" variableName="toolResults" />
		<set-variable value='#[{"tools":  []}]' doc:name="Set Tool Planning" doc:id="757132fb-4604-4bcd-a3d6-1b7e027c1a0c" variableName="planningPayload"/>
		<mcp:list-tools doc:name="List tools" doc:id="be1abede-9220-4ea9-9d50-fe7f5cfa0c58" config-ref="MCP_Client" />
		<ee:transform doc:name="Save all available tools into the right format" doc:id="bf64db27-3fb2-409a-ab4f-4bf31179e3bd" >
			<ee:message >
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="tools" ><![CDATA[%dw 2.0
output application/json
---
{
  tools: payload map (item) -> {
    "type": "function",
    function: {
      name: item.name,
      description: item.description,
      parameters: {
        "type": "object",
        properties: (read(item.inputSchema, "application/json").properties default {}),
