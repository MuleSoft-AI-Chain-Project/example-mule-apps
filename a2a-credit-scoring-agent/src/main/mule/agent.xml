				<ee:set-payload><![CDATA[%dw 2.0
output text/plain
---
write(payload, "application/json")]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<logger level="INFO" doc:name="Logger" doc:id="9fffa2ba-191d-4ce3-9de7-3b0f339b8674" message="#['payload after the call tool' ++ payload]"/>
